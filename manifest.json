{
  "manifest_version": 3,
  "name": "StealthTube",
  "version": "4.1.0",
  "description": "Watch YouTube logged in (keep Premium) without polluting your watch history or recommendations.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "StealthTube",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "scripting",
    "tabs",
    "alarms",
    "webNavigation"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://s.youtube.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "iron_curtain",
        "enabled": true,
        "path": "rules_curtain.json"
      },
      {
        "id": "stealth_ruleset",
        "enabled": false,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["browser-polyfill.js", "config.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content.css"],
      "matches": ["*://*.youtube.com/*"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "stealthtube@costincernea.com",
      "strict_min_version": "115.0"
    }
  }
}
